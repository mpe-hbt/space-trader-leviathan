{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@leviathan/shared": ["./packages/shared/src"],
      "@leviathan/api-client": ["./packages/api-client/src"]
    }
  },
  "include": ["src/renderer/src", "packages/*/src"],
  "exclude": ["packages/**/*.test.ts"]
}
