#!/bin/sh
# Lint, type check and fast tests. Runs offline; needs `npm ci` done once.
# Enable once per clone: git config core.hooksPath .githooks
set -eu
cd "$(git rev-parse --show-toplevel)"
if [ ! -d node_modules ]; then
  echo "pre-commit: node_modules missing, run 'npm ci' first" >&2
  exit 1
fi
npm run --silent lint
npm run --silent typecheck
npm run --silent test
